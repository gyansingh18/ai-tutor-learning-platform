<% if user_signed_in? %>
  <!-- Authenticated User Dashboard -->
  <div class="container my-4 my-md-5">

    <!-- Hero Section -->
    <section class="dashboard-hero mb-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
          <h1 class="fw-bold mb-1">Hi <%= current_user.display_name || 'there' %> 👋</h1>
          <p class="text-secondary mb-3">Ready to learn something new today?</p>
          <div class="d-flex gap-2 flex-wrap">
            <span class="badge bg-primary-subtle text-primary badge-chip">AI‑Powered</span>
            <span class="badge bg-success-subtle text-success badge-chip">Progress Tracking</span>
            <span class="badge bg-info-subtle text-info badge-chip">Personalized</span>
          </div>
        </div>
        <div class="text-md-end">
          <% if @resume_chapter %>
            <%= link_to "Continue where you left off", learning_path(@resume_chapter), class: "btn btn-primary btn-lg" %>
          <% else %>
            <%= link_to "Start Learning", "#start-learning-form", class: "btn btn-primary btn-lg" %>
          <% end %>
        </div>
      </div>
    </section>

    <!-- Progress Cards -->
    <% if @learning_stats %>
      <section class="progress-cards row g-3 mb-4">
        <%= render "dashboard/progress_card",
            title: "Chapters Started",
            value: @learning_stats[:total_chapters_started] || 0,
            color: "primary",
            percent: calculate_percentage(@learning_stats[:total_chapters_started], 50) %>
        <%= render "dashboard/progress_card",
            title: "Chapters Completed",
            value: @learning_stats[:completed_chapters] || 0,
            color: "success",
            percent: calculate_percentage(@learning_stats[:completed_chapters], @learning_stats[:total_chapters_started]) %>
        <%= render "dashboard/progress_card",
            title: "Tasks Completed",
            value: @learning_stats[:total_tasks_completed] || 0,
            color: "info",
            percent: calculate_percentage(@learning_stats[:total_tasks_completed], 100) %>
        <%= render "dashboard/progress_card",
            title: "Accuracy",
            value: "#{(@learning_stats[:accuracy_rate] || 0).to_i}%",
            color: "warning",
            percent: (@learning_stats[:accuracy_rate] || 0) %>
      </section>
    <% else %>
      <section class="progress-cards row g-3 mb-4">
        <%= render "dashboard/progress_card", title: "Chapters Started", value: 0, color: "primary", percent: 0 %>
        <%= render "dashboard/progress_card", title: "Chapters Completed", value: 0, color: "success", percent: 0 %>
        <%= render "dashboard/progress_card", title: "Tasks Completed", value: 0, color: "info", percent: 0 %>
        <%= render "dashboard/progress_card", title: "Accuracy", value: "0%", color: "warning", percent: 0 %>
      </section>
    <% end %>

    <div class="row g-4">
      <!-- Start Learning -->
      <section class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-white border-0 pb-0">
            <h5 class="mb-0">
              <i class="fas fa-rocket me-2"></i>
              Start Learning
            </h5>
          </div>
          <div class="card-body">
            <%= render "dashboard/start_learning_form" %>
            <hr class="my-4">
            <h6 class="mb-3">Recommended for you</h6>
            <div class="row g-3">
              <% recommended_subjects = Subject.includes(:chapters).limit(6) %>
              <% if recommended_subjects.any? %>
                <%= render partial: "dashboard/subject_card", collection: recommended_subjects, as: :subject %>
              <% else %>
                <div class="col-12">
                  <p class="text-muted text-center">Start learning to get personalized recommendations!</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </section>

      <!-- Quick Actions + Why -->
      <aside class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4 quick-panel">
          <div class="card-header bg-white border-0 pb-0 d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
              <i class="fas fa-bolt me-2"></i>
              Quick Actions
            </h6>
          </div>
          <div class="list-group list-group-flush">
            <%= link_to profile_path, class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
              <span><i class="fas fa-user-graduate me-2"></i>My Dashboard</span>
