<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Admin Dashboard", admin_dashboard_path %></li>
          <li class="breadcrumb-item"><%= link_to "Chapters", admin_chapters_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Edit Chapter</li>
        </ol>
      </nav>

      <h1 class="display-4 text-primary">Edit Chapter</h1>
      <p class="lead">Update chapter information</p>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <%= form_with model: [:admin, @chapter], local: true do |form| %>
            <% if @chapter.errors.any? %>
              <div class="alert alert-danger">
                <h4><%= pluralize(@chapter.errors.count, "error") %> prohibited this chapter from being saved:</h4>
                <ul>
                  <% @chapter.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :name, "Chapter Name", class: "form-label" %>
              <%= form.text_field :name, class: "form-control", placeholder: "Enter chapter name" %>
            </div>

            <div class="mb-3">
              <%= form.label :description, "Description", class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 3, placeholder: "Enter chapter description" %>
            </div>

            <div class="mb-3">
              <%= form.label :subject_id, "Subject", class: "form-label" %>
              <%= form.collection_select :subject_id, @subjects, :id, :display_name, { prompt: "Select a subject" }, { class: "form-select" } %>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
              <%= form.submit "Update Chapter", class: "btn btn-primary me-md-2" %>
              <%= link_to "Cancel", admin_chapters_path, class: "btn btn-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Chapter Information</h5>
        </div>
        <div class="card-body">
          <p><strong>Current Subject:</strong> <%= @chapter.subject.display_name %></p>
          <p><strong>Questions:</strong> <%= @chapter.questions.count %></p>
          <p><strong>PDF Materials:</strong> <%= @chapter.pdf_materials.count %></p>
          <p><strong>Created:</strong> <%= @chapter.created_at.strftime("%B %d, %Y") %></p>
        </div>
      </div>

      <!-- PDF Materials Section -->
      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">PDF Materials</h5>
          <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#uploadPdfModal">
            <i class="fas fa-plus"></i> Upload PDF
          </button>
        </div>
        <div class="card-body">
          <% if @chapter.pdf_materials.any? %>
            <% @chapter.pdf_materials.each do |pdf| %>
              <div class="d-flex justify-content-between align-items-center mb-3 p-2 border rounded">
                <div>
                  <strong><%= pdf.title %></strong><br>
                  <small class="text-muted">
                    <%= pdf.file_size.present? ? number_to_human_size(pdf.file_size) : 'Size unknown' %> • 
                    <%= pdf.created_at.strftime("%b %d, %Y") %>
                  </small>
                </div>
                <div>
                  <% if pdf.pdf_file.attached? %>
                    <%= link_to pdf.pdf_file, class: "btn btn-sm btn-outline-primary me-1", target: "_blank" do %>
                      <i class="fas fa-eye"></i>
                    <% end %>
                  <% end %>
                  <%= link_to admin_pdf_material_path(pdf), method: :delete, 
                      confirm: "Are you sure you want to delete this PDF?",
                      class: "btn btn-sm btn-outline-danger" do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted mb-0">No PDF materials uploaded yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Upload PDF Modal -->
<div class="modal fade" id="uploadPdfModal" tabindex="-1" aria-labelledby="uploadPdfModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="uploadPdfModalLabel">Upload PDF Material</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with model: [:admin, @chapter, PdfMaterial.new], local: true, multipart: true do |form| %>
        <div class="modal-body">
          <div class="mb-3">
            <%= form.label :title, "Title", class: "form-label" %>
            <%= form.text_field :title, class: "form-control", placeholder: "Enter PDF title" %>
            <div class="form-text">A descriptive name for this PDF material</div>
          </div>

          <div class="mb-3">
            <%= form.label :pdf_file, "PDF File", class: "form-label" %>
            <%= form.file_field :pdf_file, class: "form-control", accept: ".pdf" %>
            <div class="form-text">Select a PDF file to upload (max 10MB)</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= form.submit "Upload PDF", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
