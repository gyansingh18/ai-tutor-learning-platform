<div class="card fade-in">
  <div class="card-header">
    <h5 class="mb-0">
      <i class="fas fa-edit me-2"></i>
      Your Question
    </h5>
  </div>
  <div class="card-body">
    <% unless user_signed_in? %>
      <div class="alert alert-info mb-4">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Sign in required:</strong> You need to
        <%= link_to "sign in", new_user_session_path, class: "alert-link" %>
        to submit questions. You can still explore the grade and subject options below.
      </div>
    <% end %>

    <% if @selected_chapter %>
      <div class="alert alert-info mb-4">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Continue learning about <%= @selected_chapter.display_name %></strong>
      </div>
    <% end %>

    <%= form_with model: question, data: {
      controller: "validation dependent-selects",
      turbo: true,
      "dependent-selects-subjects-value": @subjects_by_grade.to_json,
      "dependent-selects-chapters-value": @chapters_by_subject.to_json
    }, class: "needs-validation", novalidate: true do |form| %>
      <div class="row g-3" id="question-form"
           data-controller="dependent-selects"
           data-dependent-selects-subjects-value="<%= @subjects_by_grade.to_json %>"
           data-dependent-selects-chapters-value="<%= @chapters_by_subject.to_json %>">

        <div class="col-12">
          <div class="form-group">
            <label for="question-content" class="form-label">
              <i class="fas fa-pencil-alt me-2"></i>
              <strong>Your Question</strong>
            </label>
            <%= form.text_area :content,
                placeholder: "Describe your question in detail...",
                class: "form-control #{'is-invalid' if question.errors[:content].any?}",
                id: "question-content",
                rows: 4,
                required: true %>
            <% if question.errors[:content].any? %>
              <div class="invalid-feedback">
                <%= question.errors[:content].join(", ") %>
              </div>
            <% end %>
            <div class="form-text">
              <i class="fas fa-info-circle me-1"></i>
              Be specific! The more details you provide, the better the answer will be.
            </div>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <label for="ask-grade-select" class="form-label">
            <i class="fas fa-graduation-cap me-2"></i>
            Grade Level
          </label>
          <select id="ask-grade-select" class="form-select"
                  data-dependent-selects-target="grade"
                  data-action="change->dependent-selects#gradeChanged">
            <option value="">Select a grade</option>
            <% if @subjects_by_grade %>
              <% @subjects_by_grade.keys.each do |grade_id| %>
                <% grade = Grade.find(grade_id) %>
                <option value="<%= grade_id %>"><%= grade.name %></option>
              <% end %>
            <% end %>
          </select>
        </div>

        <div class="col-12 col-md-4">
          <label for="ask-subject-select" class="form-label">
            <i class="fas fa-book me-2"></i>
            Subject
          </label>
          <select id="ask-subject-select" class="form-select"
                  data-dependent-selects-target="subject"
                  data-action="change->dependent-selects#subjectChanged"
                  disabled>
            <option value="">Select a subject</option>
          </select>
        </div>

        <div class="col-12 col-md-4">
          <label for="ask-chapter-select" class="form-label">
            <i class="fas fa-file-alt me-2"></i>
            Chapter
          </label>
          <%= form.select :chapter_id, options_for_select([["Select a chapter", ""]]),
              {},
              { class: "form-select #{'is-invalid' if question.errors[:chapter_id].any?}",
                id: "ask-chapter-select",
                "data-dependent-selects-target": "chapter",
                required: true,
                disabled: true } %>
          <% if question.errors[:chapter_id].any? %>
            <div class="invalid-feedback">
              <%= question.errors[:chapter_id].join(", ") %>
            </div>
          <% end %>
          <div class="form-text">
            <i class="fas fa-info-circle me-1"></i>
            Selecting a chapter helps provide more targeted answers.
          </div>
        </div>

        <% if @selected_chapter %>
          <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Follow-up Question:</strong> You're asking about <%= @selected_chapter.display_name %>
          </div>
        <% end %>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
          <%= link_to questions_path, class: "btn btn-outline-secondary me-md-2" do %>
            <i class="fas fa-arrow-left me-2"></i>
            Back to Questions
          <% end %>
          <%= form.submit "Ask Question",
              class: "btn btn-primary btn-lg #{'disabled' unless user_signed_in?}",
              disabled: !user_signed_in? do %>
            <i class="fas fa-paper-plane me-2"></i>
            <%= user_signed_in? ? "Ask Question" : "Sign In to Ask Question" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
